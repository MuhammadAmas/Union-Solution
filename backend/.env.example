# Copy to .env for local (non-Docker) runs. docker-compose.yml sets the
# Postgres variables itself; this file only matters if you run
# `uvicorn app.main:app` directly on your machine.

# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=callout
# POSTGRES_USER=callout
# POSTGRES_PASSWORD=callout

# Optional: enables the real LLM path in app/ai.py. Left unset, the AI draft
# endpoint runs in heuristic fallback mode -- fully functional, no key needed.
# ANTHROPIC_API_KEY=
